# Firebase Local Emulator Suite
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-yukimiworks.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-yukimiworks
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-yukimiworks.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:demo

# Firebase Admin SDK（本番のみ。ローカルエミュレーターでは不要）
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# お題メーカー週次更新（Vercel Cron）
CRON_SECRET=
DISCORD_WEBHOOK_URL=

# X API OAuth 2.0（X Developer ConsoleのWeb App設定）
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_CALLBACK_URL=http://localhost:3000/api/x/callback
# trueの間はX APIを呼ばず、Firestore上で投稿済みとして記録する
X_POST_DRY_RUN=false
# Vercel Productionで今週のお題をXへ自動投稿する場合だけtrue
X_WEEKLY_ODAI_ENABLED=false

# Existing integrations (set only when the corresponding feature is tested)
RESEND_API_KEY=
CONTACT_TO_INQUIRY=
CONTACT_TO_APP=
MAIL_FROM_NAME=YukimiWorks
MAIL_FROM_DOMAIN=yukimiworks.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# アカウント購入のデバッグモード。本番・Stripeテスト時はfalseにする
NEXT_PUBLIC_STRIPE_PURCHASE_DEBUG=true
STRIPE_PRICE_COIN_10=
STRIPE_PRICE_COIN_110=
STRIPE_PRICE_BLUE_TICKET=
STRIPE_PRICE_NIGHT_TICKET=
STRIPE_PURCHASE_WEBHOOK_SECRET=
