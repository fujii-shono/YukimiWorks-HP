rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validUser(data) {
      return data.keys().hasOnly([
          'displayName', 'plan', 'tickets', 'coins', 'purchasedWorkIds', 'role',
          'stripeCustomerId', 'stripeSubscriptions', 'createdAt', 'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 30
        && data.plan in ['none', 'blue', 'night']
        && (!('tickets' in data) || validTickets(data.tickets))
        && (!('stripeCustomerId' in data) || data.stripeCustomerId is string)
        && (!('stripeSubscriptions' in data) || data.stripeSubscriptions is map)
        && data.coins is int
        && data.coins >= 0
        && data.purchasedWorkIds is list
        && data.purchasedWorkIds.size() <= 1000
        && data.role in ['user', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validTickets(tickets) {
      return tickets is list
        && tickets.size() <= 2
        && (tickets.size() < 1 || tickets[0] in ['blue', 'night'])
        && (tickets.size() < 2 || tickets[1] in ['blue', 'night']);
    }

    function validImage(image) {
      return image is map
        && image.keys().hasOnly(['url', 'path', 'alt'])
        && image.url is string
        && image.url.size() > 0
        && image.path is string
        && image.path.size() > 0
        && image.alt is string
        && image.alt.size() <= 120;
    }

    function validImages(images) {
      return images is list
        && images.size() <= 4
        && (images.size() < 1 || validImage(images[0]))
        && (images.size() < 2 || validImage(images[1]))
        && (images.size() < 3 || validImage(images[2]))
        && (images.size() < 4 || validImage(images[3]));
    }

    function validContentMedia(media) {
      return media is map
        && media.keys().hasOnly(['type', 'url', 'path', 'alt'])
        && media.type in ['image', 'video']
        && media.url is string
        && media.url.size() > 0
        && media.path is string
        && media.path.size() > 0
        && media.alt is string
        && media.alt.size() <= 160;
    }

    function validContentMediaList(media) {
      return media is list
        && media.size() <= 8
        && (media.size() < 1 || validContentMedia(media[0]))
        && (media.size() < 2 || validContentMedia(media[1]))
        && (media.size() < 3 || validContentMedia(media[2]))
        && (media.size() < 4 || validContentMedia(media[3]))
        && (media.size() < 5 || validContentMedia(media[4]))
        && (media.size() < 6 || validContentMedia(media[5]))
        && (media.size() < 7 || validContentMedia(media[6]))
        && (media.size() < 8 || validContentMedia(media[7]));
    }

    function validContentCommon(data) {
      return data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.publishedAt is timestamp
        && data.noIndex is bool
        && (data.seoTitle == null || (data.seoTitle is string && data.seoTitle.size() <= 160))
        && (data.seoDescription == null || (data.seoDescription is string && data.seoDescription.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validMessage(data) {
      return data.keys().hasOnly([
          'body', 'authorName', 'images', 'postToX', 'publishedAt', 'createdAt', 'updatedAt',
          'xPostStatus', 'xPostId', 'xPostError', 'xPostAttemptedAt', 'xPostedAt'
        ])
        && data.body is string
        && data.body.size() >= 1
        && data.body.size() <= 300
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 30
        && validImages(data.images)
        && data.postToX is bool
        && (!('xPostStatus' in data) || data.xPostStatus in ['not_requested', 'pending', 'posting', 'posted', 'failed', 'skipped_too_long'])
        && (!('xPostId' in data) || data.xPostId == null || data.xPostId is string)
        && (!('xPostError' in data) || data.xPostError == null || (data.xPostError is string && data.xPostError.size() <= 500))
        && (!('xPostAttemptedAt' in data) || data.xPostAttemptedAt == null || data.xPostAttemptedAt is timestamp)
        && (!('xPostedAt' in data) || data.xPostedAt == null || data.xPostedAt is timestamp)
        && data.publishedAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && validUser(request.resource.data)
        && request.resource.data.role == 'user'
        && request.resource.data.plan == 'none'
        && request.resource.data.tickets.size() == 0
        && !('stripeCustomerId' in request.resource.data)
        && !('stripeSubscriptions' in request.resource.data)
        && request.resource.data.coins == 10
        && request.resource.data.purchasedWorkIds.size() == 0;
      allow update: if signedIn()
        && request.auth.uid == userId
        && validUser(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow create, update: if isAdmin() && validMessage(request.resource.data);
      allow delete: if isAdmin();
    }

    match /portfolioItems/{itemId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'description', 'tags', 'image', 'publishedAt', 'featured', 'seoTitle', 'seoDescription', 'noIndex', 'createdAt', 'updatedAt'])
        && validContentCommon(request.resource.data)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 5000
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 30
        && validContentMedia(request.resource.data.image)
        && request.resource.data.image.type == 'image'
        && request.resource.data.featured is bool;
      allow delete: if isAdmin();
    }

    match /works/{itemId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'body', 'bodySegments', 'category', 'tags', 'thumbnail', 'media', 'publishedAt', 'url', 'featured', 'seoTitle', 'seoDescription', 'noIndex', 'createdAt', 'updatedAt'])
        && validContentCommon(request.resource.data)
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 50000
        && request.resource.data.bodySegments is list
        && request.resource.data.bodySegments.size() <= 50
        && request.resource.data.category in ['contents', 'tools', 'apps']
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 30
        && (request.resource.data.thumbnail == null || validContentMedia(request.resource.data.thumbnail))
        && validContentMediaList(request.resource.data.media)
        && (request.resource.data.url == null || (request.resource.data.url is string && request.resource.data.url.size() <= 2048))
        && request.resource.data.featured is bool;
      allow delete: if isAdmin();
    }

    match /diaryEntries/{itemId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'body', 'bodySegments', 'category', 'eyecatch', 'publishedAt', 'seoTitle', 'seoDescription', 'noIndex', 'createdAt', 'updatedAt'])
        && validContentCommon(request.resource.data)
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 100000
        && request.resource.data.bodySegments is list
        && request.resource.data.bodySegments.size() <= 50
        && request.resource.data.category in ['chat', 'report', 'development', 'behind-the-scenes', 'content-creation-tips']
        && (request.resource.data.eyecatch == null || validContentMedia(request.resource.data.eyecatch));
      allow delete: if isAdmin();
    }

    match /news/{itemId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'body', 'bodySegments', 'category', 'thumbnail', 'media', 'publishedAt', 'featured', 'seoTitle', 'seoDescription', 'noIndex', 'createdAt', 'updatedAt'])
        && validContentCommon(request.resource.data)
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 100000
        && request.resource.data.bodySegments is list
        && request.resource.data.bodySegments.size() <= 50
        && request.resource.data.category in ['event', 'announcement', 'release', 'other']
        && (request.resource.data.thumbnail == null || validContentMedia(request.resource.data.thumbnail))
        && validContentMediaList(request.resource.data.media)
        && request.resource.data.featured is bool;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
