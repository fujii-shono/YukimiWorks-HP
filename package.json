{
  "name": "yukimiworks-hp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:firebase": "firebase emulators:exec --project demo-yukimiworks --only auth,firestore,storage \"npm run dev\"",
    "firebase:emulators": "node scripts/start-firebase-emulators.mjs",
    "firebase:cleanup": "node scripts/stop-firebase-emulators.mjs",
    "firebase:seed:bunny": "node scripts/register-bunny-r18.mjs --emulator",
    "firebase:publish:bunny": "node --env-file-if-exists=.env.local scripts/register-bunny-r18.mjs --production",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,storage",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "acrylic:baseline": "node scripts/acrylic-regression.mjs baseline",
    "acrylic:compare": "node scripts/acrylic-regression.mjs compare",
    "acrylic:stand-claw-check": "node scripts/acrylic-regression.mjs stand-claw-check"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@upstash/redis": "^1.38.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^11.3.19",
    "next": "14.2.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "resend": "^4.0.0",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.30",
    "firebase-tools": "^15.32.0",
    "typescript": "^5.7.2"
  }
}
